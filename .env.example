EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-supabase-key

# Supabase Edge Functions: use "openai", "ollama" or "opencode".
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key
# For Ollama, set AI_PROVIDER=ollama and expose a reachable OpenAI-compatible URL.
# AI_BASE_URL=https://your-ollama-host.example.com/v1/chat/completions
# OLLAMA_API_KEY=
# For OpenCode, set AI_PROVIDER=opencode and provide its API key.
# OPENCODE_GO_API_KEY=your-opencode-api-key

# Supabase Edge Function secret (do not expose this in the mobile bundle).
# Places provider for AI-101: Google Places is the optional primary provider.
# Leave it unset to use the Geoapify fallback.
# GOOGLE_PLACES_API_KEY=your-google-places-api-key
# GEOAPIFY_API_KEY=your-geoapify-api-key
# UNSPLASH_ACCESS_KEY=your-unsplash-access-key
